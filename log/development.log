          <td><%= taxi.numero %></td>
          <td><%= taxi.x %></td>
          <td><%= taxi.y %></td>
          <td><%= link_to "Show this taxi", taxi %></td>
          <td>
          <% if taxi.mijanona==0 then %>
          <%= link_to "Annuler this taxi", taxis_test(:tax =>taxi) %>
          <% elsif taxi.mijanona==1 then %>
             <%= link_to "Reprendre this taxi", taxis_test(:tax taxi) %>
             <% end %>
          </td>
       </tr>
    <% end %>
    </table>

</div>

