<p style="color: green"><%= notice %></p>
<% if params[:potata]!=nil %>
   <%= "hello"+params[:potata]  %>
<%end%>
<% login=Login.find(1).idclient %>
<h1>List Taxis</h1>

<div id="taxis">

    <table border="1" class="table table-striped table-dark">
     <tr>
         <th>Numero</th>
         <th>x:</th>
         <th>y:</th>
         <th>Dx:</th>
         <th>Dy:</th>
         <th>status</th>
         <th></th>
         <th></th>
         <th>nombre passager</th>
     </tr>
    <% @taxis.each do |taxi| %>
       <tr>
          <td><%= taxi.numero %></td>
          <td><%= taxi.x %></td>
          <td><%= taxi.y %></td>
          <td><%= taxi.dx %></td>
          <td><%= taxi.dy %></td>
          <td><%= taxi.status %></td>
          <td><%= link_to "Show this taxi", taxi %></td>
          <td>
          <% if taxi.mijanona==0 then %>
          <%= link_to "Annuler this taxi", taxis_test_path(:id =>taxi.id,:check=>1) %>
          <% elsif taxi.mijanona==1 then %>
             <%= link_to "Reprendre this taxi", taxis_test_path(:id =>taxi.id,:check=>0) %>
             <% end %>
          </td>
          <td>
             <%= List.where(idtaxi:taxi.id).count %>
          </td>
          
       </tr>
    <% end %>
    </table>

</div>

<%= link_to "New taxi", new_taxi_path %>
