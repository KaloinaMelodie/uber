<%= form_with(model: taxi) do |form| %>
  <% if taxi.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(taxi.errors.count, "error") %> prohibited this taxi from being saved:</h2>

      <ul>
        <% taxi.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :numero, style: "display: block" %>
    <%= form.text_field :numero %>
  </div>

  <div>
    <%= form.label :x, style: "display: block" %>
    <%= form.number_field :x %>
  </div>

  <div>
    <%= form.label :y, style: "display: block" %>
    <%= form.number_field :y %>
  </div>

  <div>
    <%= form.label :dx, style: "display: block" %>
    <%= form.number_field :dx %>
  </div>

  <div>
    <%= form.label :dy, style: "display: block" %>
    <%= form.number_field :dy %>
  </div>

  <div>
    <%= form.label :status, style: "display: block" %>
    <%= form.number_field :status %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
