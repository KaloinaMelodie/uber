<%= form_with(model: position) do |form| %>
  <% if position.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(position.errors.count, "error") %> prohibited this position from being saved:</h2>

      <ul>
        <% position.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :x, style: "display: block" %>
    <%= form.number_field :x %>
  </div>

  <div>
    <%= form.label :y, style: "display: block" %>
    <%= form.number_field :y %>
  </div>

  <div>
    <%= form.label :distance, style: "display: block" %>
    <%= form.number_field :distance %>
  </div>

  <div>
    <%= form.label :dx, style: "display: block" %>
    <%= form.number_field :dx %>
  </div>

  <div>
    <%= form.label :dy, style: "display: block" %>
    <%= form.number_field :dy %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
