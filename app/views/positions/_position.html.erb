<div id="<%= dom_id position %>">
  <p>
    <strong>ID:</strong>
    <%= position.id %>
  </p>

  <p>
    <strong>X:</strong>
    <%= position.x %>
  </p>

  <p>
    <strong>Y:</strong>
    <%= position.y %>
  </p>

  <p>
    <strong>Distance:</strong>
    <%= position.distance %>
  </p>

  <p>
    <strong>DX:</strong>
    <%= position.dx %>
  </p>

  <p>
    <strong>DY:</strong>
    <%= position.dy %>
  </p>

</div>
