<%= form_with(model: chemin) do |form| %>
  <% if chemin.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(chemin.errors.count, "error") %> prohibited this chemin from being saved:</h2>

      <ul>
        <% chemin.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :chemin, style: "display: block" %>
